      "description": "Inactive is bordered on cream; active is filled with ink.",
      "html": "<div class=\"ds-wrap\"><button class=\"ds-chip\">Todos</button> <button class=\"ds-chip ds-chip-active\" aria-pressed=\"true\">Mujer</button></div>",
      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-chip{height:46px;padding:0 18px;border:1px solid var(--input);border-radius:4px;background:var(--background);color:var(--foreground);font:500 13px Outfit,system-ui,sans-serif;cursor:pointer;outline:none;transition:background-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-chip:hover{background:var(--muted)}\n.ds-chip-active{background:var(--primary);border-color:var(--primary);color:var(--primary-foreground)}\n.ds-chip-active:hover{background:var(--primary)}\n.ds-chip:focus-visible{box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Product Card",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Bordered Card Vellum card; photo area on cream with a bottom rule; hover shifts the border to ink.",
      "html": "<div class=\"ds-wrap\"><a class=\"ds-card\" href=\"#\"><div class=\"ds-card-photo\"><span class=\"ds-card-badge\">NUEVO</span></div><div class=\"ds-card-body\"><span class=\"ds-card-eyebrow\">Marca</span><h3 class=\"ds-card-title\">Nombre del perfume</h3><div class=\"ds-card-price\"><span class=\"ds-card-from\">desde</span><span class=\"ds-card-amount\">$ 85.000</span></div></div></a></div>",
      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-card{display:flex;flex-direction:column;overflow:hidden;width:260px;border:1px solid var(--border);border-radius:4px;background:var(--card);color:inherit;text-decoration:none;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1);outline:none}\n.ds-card:hover{border-color:var(--foreground)}\n.ds-card:focus-visible{box-shadow:0 0 0 2px var(--ring)}\n.ds-card-photo{position:relative;height:180px;border-bottom:1px solid var(--border);background:var(--background)}\n.ds-card-badge{position:absolute;top:12px;left:12px;border-radius:3.2px;background:var(--primary);color:var(--primary-foreground);padding:6px 10px;font:700 11px/1 Outfit,system-ui,sans-serif;letter-spacing:0.16em}\n.ds-card-body{display:flex;flex-direction:column;gap:6px;padding:14px}\n.ds-card-eyebrow{font:700 11px Outfit,system-ui,sans-serif;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted-foreground)}\n.ds-card-title{margin:0;font:700 14px/1.25 Outfit,system-ui,sans-serif;letter-spacing:-0.015em}\n.ds-card-price{display:flex;align-items:baseline;gap:6px;padding-top:8px}\n.ds-card-from{font-size:11px;color:var(--muted-foreground)}\n.ds-card-amount{font:700 16px Outfit,system-ui,sans-serif;letter-spacing:-0.02em}"
    },
