      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-accord{display:flex;flex-direction:column;gap:6px;width:260px}\n.ds-accord-head{display:flex;align-items:baseline;justify-content:space-between}\n.ds-accord-name{font:600 14px Outfit,system-ui,sans-serif}\n.ds-accord-pct{font-size:12px;color:var(--muted-foreground)}\n.ds-accord-track{height:8px;width:100%;overflow:hidden;border-radius:2.4px;background:var(--border)}\n.ds-accord-fill{height:100%;width:80%;border-radius:2.4px;background:#8a6a4a}\n.ds-accord-track:hover{outline:1px solid var(--ring)}\n.ds-accord-track:focus-visible{outline:2px solid var(--ring)}"
