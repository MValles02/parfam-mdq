      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-input{height:32px;width:240px;box-sizing:border-box;border:1px solid var(--input);border-radius:4px;background:transparent;color:var(--foreground);padding:4px 10px;font:400 14px Outfit,system-ui,sans-serif;outline:none;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-input::placeholder{color:var(--muted-foreground)}\n.ds-input:hover{border-color:var(--ring)}\n.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
