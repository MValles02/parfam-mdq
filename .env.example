# ---- Database ----
# Port 5433 avoids the Postgres instance used by Dokploy on the VPS.
DATABASE_URL="postgresql://parfam:parfam@localhost:5433/parfam?schema=public"

# ---- Auth.js ----
# Placeholder (32+ chars, enough for local dev). Replace it for any real
# deployment. Generate with: openssl rand -base64 32
AUTH_SECRET="local-dev-only-change-me-0123456789abcdef"
# Required in production and for local `next start`. Behind a proxy such as
# Dokploy Traefik, Auth.js discards the session cookie unless it trusts the
# incoming Host. src/lib/env.ts does not validate this variable because Auth.js
# reads it directly from process.env.
AUTH_TRUST_HOST="true"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Cloudflare R2 (product images) ----
# Local dev token, scoped only to the dev bucket below (Object Read & Write).
# It can never touch production's bucket or the VPS backup bucket.
# The R2_* values below are placeholders that pass validation; replace all of
# them with real dev-bucket values only when you need real image uploads.
R2_ACCOUNT_ID="placeholder-account-id"
R2_ACCESS_KEY_ID="placeholder-access-key-id"
R2_SECRET_ACCESS_KEY="placeholder-secret-access-key"
# Dev-only bucket, separate from production's parfam-mdq-imagenes.
R2_BUCKET="parfam-mdq-imagenes-dev"
# Public bucket host without a trailing slash (this bucket's r2.dev URL). The
# database stores an object key instead of a URL, so changing this does not
# require editing existing rows.
R2_PUBLIC_URL="https://example.r2.dev"

# ---- Initial admin seed (first setup only) ----
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
