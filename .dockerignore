# Lo que no hace falta para buildear la imagen. Cuanto mas chico el contexto,
# mas rapido el `docker build` y menos capas se invalidan de gusto.

.git
.github
node_modules
.next
out
build
coverage
playwright-report
test-results
*.tsbuildinfo

# Secretos: no entran a la imagen ni por accidente. Las variables reales las
# pone Dokploy en runtime y CI en los build args.
.env
.env.*
!.env.example

# Reference dataset: imported from a developer machine, never from the container.
/new-database/

# Material de trabajo que no participa del build.
design
brand
.husky
.vscode
.idea
docker-compose.dev.yml
Dockerfile
.dockerignore
*.md

# Keys and credentials: never part of the build context.
*.pem
*.key
.claude
.prettierignore
.lintstagedrc.json
