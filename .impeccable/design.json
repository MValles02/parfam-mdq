    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink on cream, hover at 80% ink.",
      "html": "<div class=\"ds-wrap\"><button class=\"ds-btn ds-btn-primary\">Agregar al carrito</button></div>",
      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:4px;font:500 14px Outfit,system-ui,sans-serif;height:32px;padding:0 10px;cursor:pointer;outline:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-btn-primary{background:var(--primary);color:var(--primary-foreground)}\n.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}\n.ds-btn:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}\n.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Ledger Line border on cream, Warm Taupe Fill on hover.",
      "html": "<div class=\"ds-wrap\"><button class=\"ds-btn ds-btn-outline\">Ver detalle</button></div>",
      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:4px;font:500 14px Outfit,system-ui,sans-serif;height:32px;padding:0 10px;cursor:pointer;outline:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-btn-outline{background:var(--background);color:var(--foreground);border-color:var(--border)}\n.ds-btn-outline:hover{background:var(--muted)}\n.ds-btn:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}\n.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "WhatsApp Button",
      "kind": "button",
      "refersTo": "button-whatsapp",
      "description": "Counter Green with cream text, 54px high; the only green call to action.",
      "html": "<div class=\"ds-wrap\"><button class=\"ds-btn ds-btn-wa\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z\"/></svg>&nbsp;Pedir por WhatsApp</button></div>",
      "css": ".ds-wrap{font-family:Outfit,system-ui,sans-serif;background:var(--background);color:var(--foreground);padding:16px}\n.ds-btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:4px;font:500 14px Outfit,system-ui,sans-serif;height:32px;padding:0 10px;cursor:pointer;outline:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-btn-wa{background:var(--whatsapp);color:var(--whatsapp-foreground);height:54px;padding:0 22px;gap:8px}\n.ds-btn-wa:hover{background:color-mix(in oklch,var(--whatsapp) 90%,black)}\n.ds-btn:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}\n.ds-btn:active{transform:translateY(1px)}"
    },
    {
