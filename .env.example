# ---- Base de datos ----
# Puerto 5433 para no chocar con el Postgres que corre Dokploy en la VPS.
DATABASE_URL="postgresql://parfam:parfam@localhost:5433/parfam?schema=public"

# ---- Auth.js ----
# OBLIGATORIA. Generar con: openssl rand -base64 32
AUTH_SECRET=""
# Obligatoria en produccion (y al probar `next start` en local): detras de un
# proxy como el Traefik de Dokploy, Auth.js descarta la cookie de sesion si no
# confia en el Host que le llega. Sin esto el login "entra" pero la navegacion
# siguiente rebota a /admin/login. No la valida src/lib/env.ts: la lee Auth.js
# directo de process.env.
AUTH_TRUST_HOST="true"

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Cloudflare R2 (imagenes de producto) ----
# El token tiene que estar acotado SOLO al bucket de imagenes: no reusar el de
# los backups de la VPS, que es otro bucket y otro alcance.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="parfam-mdq-imagenes"
# Host publico del bucket, sin barra final. La base guarda la clave del objeto,
# no la URL, asi que cambiar esto NO obliga a tocar ninguna fila.
R2_PUBLIC_URL="https://img.parfammdq.com"

# ---- Analitica (Umami self-hosted) ----
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ---- Seed del admin inicial (solo primera carga) ----
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
