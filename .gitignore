# Dependencias
node_modules/
.pnpm-store/

# Next.js
.next/
out/
build/
next-env.d.ts

# Entorno
.env
.env.*
!.env.example

# FragDB: los CSV completos (~900 MB, licencia comercial) no se versionan.
# Se suben por scp a data/fragdb/ y se quedan sólo en la VPS.
data/fragdb/*
!data/fragdb/README.md
!data/fragdb/SPEC.md
!data/fragdb/data_dictionary.md
!data/fragdb/samples/

