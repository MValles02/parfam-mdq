  "narrative": {
    "northStar": "The Lab Notebook",
    "overview": "The store reads as a perfumer's notebook that happens to sell perfume: cream paper, black ink, hairline rules, and annotated technical data (a notes pyramid, accord bars, a spec list) sitting next to a shop. Nothing is decorated. Structure comes from 1px rules and from the type itself.\n\nIt is typographic (the logo is set type, and hierarchy comes from weight, size and tracking in one family), warm (taupe neutrals, not grey), precise (small radii, exact 1px rules, tabular data) and old-luxury (restraint, generous margins, tracked small labels, confidence from tight display type rather than ornament).\n\nThe system explicitly rejects luxury-gold, metallic and foil treatments, and modern luxury (glossy surfaces, dark black-and-gold, glassmorphism).",
    "keyCharacteristics": [
      "Cream paper surface with black ink as the only emphasis.",
      "One typeface, Outfit, with hierarchy built from weight, size and tracking.",
      "Flat surfaces: 1px Ledger Line borders, no box-shadows.",
      "Tiny radii (4px base); rectangular and notebook-like.",
      "Technical data rendered as annotated, ledger-like rows.",
      "Mobile-first, with 44px minimum touch targets."
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Black is the only emphasis. Every solid call to action and every active state is ink on cream.",
        "section": "colors"
      },
      {
        "name": "The Counter Green Rule",
        "body": "Green appears only on the call to action that leaves the store for WhatsApp, at most one per view.",
        "section": "colors"
      },
      {
        "name": "The Database Color Rule",
        "body": "Accord colors come from data through `getChipColor`, only as bar fills and small dots, and are never promoted to theme tokens.",
        "section": "colors"
      },
      {
        "name": "The Tracked Label Rule",
        "body": "Uppercase bold labels of 9-11px with 0.12-0.2em tracking are for eyebrows and section tags only, never sentences.",
        "section": "typography"
      },
      {
        "name": "The Set Type Rule",
        "body": "The logo is text in Outfit 800 with tracking -0.03em and a tracked \"Perfumería\" subtitle. Never replace it with an image or a second typeface.",
        "section": "typography"
      },
      {
        "name": "The No-Shadow Rule",
        "body": "The store has no box-shadows. Separate surfaces with tone and 1px rules.",
        "section": "elevation & depth"
      },
      {
        "name": "The Cream Blend Rule",
        "body": "Product photos use mix-blend-multiply on the paper surface so white studio backgrounds disappear.",
        "section": "elevation & depth"
      }
    ],
    "dos": [
      "Do keep the single family and create hierarchy with weight, size and tracking.",
      "Do keep surfaces flat and structure them with 1px rules.",
      "Do keep ink as the one emphasis.",
      "Do render technical data (notes, accords, specs) as annotated, ledger-like rows.",
      "Do keep touch targets at 44px or larger.",
      "Do pass database colours through `getChipColor`."
    ],
    "donts": [
      "Don't use gold, bronze, foil, metallic gradients or any luxury-gold palette.",
      "Don't use modern-luxury tropes: glossy surfaces, glassmorphism, a black-and-gold dark mode, or glow.",
      "Don't add shadows or soft rounded-2xl-style corners.",
      "Don't add dark mode.",
      "Don't use green anywhere except the WhatsApp call to action and success confirmation states.",
      "Don't hotlink or show reference-data imagery that is not in R2.",
      "Don't add a second typeface without an explicit decision."
    ]
  }
}
