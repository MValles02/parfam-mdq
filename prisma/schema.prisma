// Parfam MDQ schema.
//
// Three layers:
//   1. Reference — seeded from new-database/perfumes.jsonl and read-only in the app.
//   2. Store — managed by the administrator (`Product` and its relations).
//   3. Operations — orders, site settings, and users.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 keeps the connection URL in prisma.config.ts for Migrate/CLI and
// in the driver adapter created by src/lib/db.ts at runtime.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Gender {
  WOMEN
  MEN
  UNISEX
}

enum NotePosition {
  TOP
  MIDDLE
  BASE
}

enum Concentration {
  EAU_FRAICHE
  EAU_DE_COLOGNE
  EAU_DE_TOILETTE
  EAU_DE_PARFUM
  PARFUM
  EXTRAIT
}

enum VariantKind {
  FULL_BOTTLE
  TESTER
  DECANT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
}

// ---------------------------------------------------------------------------
// Layer 1 — Reference data seeded from new-database/perfumes.jsonl
// ---------------------------------------------------------------------------

/// Perfume brand or house. The importer creates it from the brand URL segment.
model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragranceRefs FragranceRef[]
  products      Product[]

  @@index([name])
}

/// Perfumer or nose behind the fragrance.
model Perfumer {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  fragranceRefs FragranceRefPerfumer[]
  products      ProductPerfumer[]

  @@index([name])
}

/// Olfactory note or ingredient. `slug` is derived from the lowercased
/// dataset display name (`nameEn`); `nameEs` is the Spanish translation
/// supplied before import (see prisma/reference/) and is required, so the
/// importer refuses any note without one. `family` groups related display
/// names under the dataset's own family slug (e.g. several bergamot
/// varieties share the family "Bergamot") and drives the store's note filter.
model Note {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameEn     String
  nameEs     String
  /// Dataset family slug; notes created manually in the admin panel reuse
  /// their own slug here since they have no dataset family.
  family     String
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  fragranceRefs FragranceRefNote[]
  products      ProductNote[]

  @@index([nameEn])
  @@index([family])
}

/// Olfactory accord. `nameEs` and `color` come from
/// prisma/reference/accords.es.json, an in-house palette and translation
/// pair that does not copy third-party data.
model Accord {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameEs    String
  color     String
  createdAt DateTime @default(now())

  fragranceRefs FragranceRefAccord[]
  products      ProductAccord[]
}

/// A fragrance in the reference catalog. The store never displays it
/// directly: an administrator adopts it into an editable `Product` copy.
model FragranceRef {
  id            String    @id @default(cuid())
  /// Dataset record id.
  pid           Int       @unique
  /// Raw "Brand/Name" dataset slug. Not unique: two different records can
  /// share it (e.g. a flanker with an identical title under the same
  /// brand), so the dataset disambiguates with `pid`, not this slug.
  slug          String
  brandId       String
  name          String
  year          Int?
  gender        Gender?
  collection    String?
  /// Internal English text from the dataset, used only as an admin reference.
  descriptionEn String?
  /// Community-voted average longevity, 1..5; null when nobody has voted.
  longevity     Decimal?  @db.Decimal(3, 2)
  /// Community-voted average sillage, 1..4; null when nobody has voted.
  sillage       Decimal?  @db.Decimal(3, 2)
  /// Season vote counts; each is null when the whole tally is unset (see
  /// scripts/lib/reference-parse.ts normalizeSeasonVotes).
  seasonSpringVotes Int?
  seasonSummerVotes Int?
  seasonFallVotes   Int?
  seasonWinterVotes Int?
  /// Daypart vote counts; null when the whole tally is unset.
  daypartDayVotes   Int?
  daypartNightVotes Int?
  /// Dataset `people` total; internal only, never shown to customers.
  communityVotes    Int?
  /// Dataset `popularity.magnitude`; internal, ranks admin search results.
  popularity        Int?
  scrapedAt         DateTime?
  /// Denormalized "<name> <brand>" text, normalized and indexed with GIN trgm.
  /// Without it, the admin search cannot use an index because an OR across
  /// FragranceRef and Brand requires a sequential scan of the whole table.
  searchText    String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand     Brand                  @relation(fields: [brandId], references: [id])
  notes     FragranceRefNote[]
  accords   FragranceRefAccord[]
  perfumers FragranceRefPerfumer[]
  products  Product[]

  @@index([name])
  @@index([brandId])
}

model FragranceRefNote {
  id             String        @id @default(cuid())
  fragranceRefId String
  noteId         String
  /// Null for a flat note list without top/middle/base tiers.
  position       NotePosition?
  /// 0..100, normalized so the perfume's strongest note is 100. All notes
  /// at 0 means nobody has voted on this perfume's ingredients yet.
  weight         Int           @default(0)
  sortOrder      Int           @default(0)

  fragranceRef FragranceRef @relation(fields: [fragranceRefId], references: [id], onDelete: Cascade)
  note         Note         @relation(fields: [noteId], references: [id])

  @@index([fragranceRefId])
  @@index([noteId])
}

model FragranceRefAccord {
  id             String @id @default(cuid())
  fragranceRefId String
  accordId       String
  /// 0..100 dataset accord strength.
  strength       Int
  /// Dataset occurrence order.
  sortOrder      Int    @default(0)

  fragranceRef FragranceRef @relation(fields: [fragranceRefId], references: [id], onDelete: Cascade)
  accord       Accord       @relation(fields: [accordId], references: [id])

  @@index([fragranceRefId])
  @@index([accordId])
}

model FragranceRefPerfumer {
  id             String @id @default(cuid())
  fragranceRefId String
  perfumerId     String

  fragranceRef FragranceRef @relation(fields: [fragranceRefId], references: [id], onDelete: Cascade)
  perfumer     Perfumer     @relation(fields: [perfumerId], references: [id])

  @@index([fragranceRefId])
  @@index([perfumerId])
}

// ---------------------------------------------------------------------------
// Layer 2 — Store data managed by the administrator
// ---------------------------------------------------------------------------

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  brandId        String
  /// Adopted reference selected from search; null for a manually created item.
  fragranceRefId String?
  /// Fragrantica URL for manual entries without a FragranceRef.
  sourceUrl      String?
  /// Spanish text written by the administrator; the only description customers see.
  description    String?
  gender         Gender?
  concentration  Concentration?
  year           Int?
  collection     String?
  /// Copied from the adopted FragranceRef (or set by the administrator for a
  /// manually created product); 1..5, shown to customers as a character bar.
  longevity      Decimal?       @db.Decimal(3, 2)
  /// Copied from the adopted FragranceRef, or set by the administrator; 1..4.
  sillage        Decimal?       @db.Decimal(3, 2)
  /// 0..100 season percentages shown to customers; copied at adoption time
  /// or set by the administrator for a manually created product.
  seasonSpring   Int?
  seasonSummer   Int?
  seasonFall     Int?
  seasonWinter   Int?
  /// 0..100 daypart percentages shown to customers.
  daypartDay     Int?
  daypartNight   Int?
  /// Copied at adoption from FragranceRef.communityVotes; null for a
  /// manually created product with no reference to copy from.
  communityVotes Int?
  intensity      Int?
  status         ProductStatus  @default(DRAFT)
  isFeatured     Boolean        @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand        Brand             @relation(fields: [brandId], references: [id])
  fragranceRef FragranceRef?     @relation(fields: [fragranceRefId], references: [id], onDelete: SetNull)
  notes        ProductNote[]
  accords      ProductAccord[]
  perfumers    ProductPerfumer[]
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@index([status])
  @@index([brandId])
  @@index([fragranceRefId])
}

model ProductNote {
  id        String        @id @default(cuid())
  productId String
  noteId    String
  /// Null for a flat note list without top/middle/base tiers.
  position  NotePosition?
  /// 0..100, copied from the adopted FragranceRefNote or set by the
  /// administrator; used by the store's "similar perfumes" query.
  weight    Int           @default(0)
  sortOrder Int           @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  note    Note    @relation(fields: [noteId], references: [id])

  @@index([productId])
  @@index([noteId])
}

model ProductAccord {
  id        String @id @default(cuid())
  productId String
  accordId  String
  /// 0..100, copied from the adopted FragranceRefAccord or set by the
  /// administrator; used by the store's "similar perfumes" query.
  strength  Int    @default(0)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  accord  Accord  @relation(fields: [accordId], references: [id])

  @@index([productId])
  @@index([accordId])
}

model ProductPerfumer {
  id         String @id @default(cuid())
  productId  String
  perfumerId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  perfumer Perfumer @relation(fields: [perfumerId], references: [id])

  @@index([productId])
  @@index([perfumerId])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  /// Cloudflare R2 object key ("products/2026/09/uuid.jpg"). Either a manual
  /// upload or a single copy of the adopted reference's picture made at
  /// adoption time (see `importReferencePicture` in
  /// `src/app/admin/(panel)/productos/image-actions.ts`); never a hotlink to
  /// fimgs.net. Storing a key instead of an absolute URL makes the public
  /// host (R2_PUBLIC_URL) configurable without rewriting existing rows.
  storageKey String
  alt        String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  kind      VariantKind
  sizeMl    Int?
  priceArs  Decimal     @db.Decimal(10, 2)
  /// Out of stock is represented by an administrator toggling this variant.
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  sku       String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Layer 3 — Orders, settings, and users
// ---------------------------------------------------------------------------

model Order {
  id            String      @id @default(cuid())
  /// Customer and administrator readable sequence, for example "PM-0042".
  number        String      @unique
  customerName  String
  customerPhone String
  status        OrderStatus @default(PENDING)
  totalArs      Decimal     @db.Decimal(10, 2)
  adminNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  /// Optional FKs prevent an order from breaking when a product or variant is
  /// deleted; it only loses its navigation link.
  productId    String?
  variantId    String?
  /// Purchase-time snapshot that never changes with the catalog.
  productName  String
  variantLabel String
  unitPriceArs Decimal @db.Decimal(10, 2)
  qty          Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Singleton row with settings editable from /admin/configuracion.
model SiteSetting {
  id                      String   @id @default("singleton")
  whatsappNumber          String
  whatsappMessageTemplate String   @db.Text
  instagramHandle         String?
  shippingInfo            String?
  seoDefaultTitle         String?
  seoDefaultDescription   String?
  updatedAt               DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
