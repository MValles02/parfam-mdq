# ---- Database ----
# Port 5433 avoids the Postgres instance used by Dokploy on the VPS.
DATABASE_URL="postgresql://parfam:parfam@localhost:5433/parfam?schema=public"

# ---- Auth.js ----
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required in production and for local `next start`. Behind a proxy such as
# Dokploy Traefik, Auth.js discards the session cookie unless it trusts the
# incoming Host. src/lib/env.ts does not validate this variable because Auth.js
# reads it directly from process.env.
AUTH_TRUST_HOST="true"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Cloudflare R2 (product images) ----
# Scope the token only to this image bucket; do not reuse the VPS backup token.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="parfam-mdq-imagenes"
# Public bucket host without a trailing slash. The database stores an object key
# instead of a URL, so changing this does not require editing existing rows.
R2_PUBLIC_URL="https://img.parfammdq.com"

# ---- Analytics (self-hosted Umami) ----
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ---- Initial admin seed (first setup only) ----
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
