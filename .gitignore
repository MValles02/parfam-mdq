# Dependencias
node_modules/
.pnpm-store/

# Next.js
/.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.*

# Entorno
.env
.env.*
!.env.example

# Local copy of the reference dataset: too large for git. Imported with
# `pnpm db:import-references` and never read at runtime.
/new-database/

# Sistema / editores
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma: cliente generado, se rearma con `prisma generate` (postinstall)
/src/generated/prisma

# Configuracion local y memoria de agentes de Claude Code: son de esta
# maquina, no del proyecto.
.claude/

# Testing
/coverage
/playwright-report/
/test-results/

# Canvas de diseno ya armado (2.5 MB, se regenera desde los .dc.html)
design/*.html
!design/*.dc.html

# Private keys and certificates
*.pem
*.key
